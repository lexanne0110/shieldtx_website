# ShieldTX site env vars. Copy to .env.local for `vercel dev`.
# Never commit real secrets.

# Scanner v2 backend/frontend used by the public preview funnel.
SCANNER_API_BASE=https://scanner.shieldtx.xyz
SCANNER_APP_BASE=https://scanner.shieldtx.xyz

# Pepper for hashing client IPs before storage.
IP_HASH_PEPPER=

# DB connection string. Left blank in Phase 1 — lib/db.js falls back to an
# in-memory stub that logs submissions. Plug in Supabase/Neon/Vercel Postgres
# here when ready.
DATABASE_URL=

# Google Sheets mirrors (lib/sheets.js). Server-to-server auth via a GCP
# service account — no OAuth consent flow needed.
#
# Setup (once):
#   1. GCP Console → APIs & Services → Library → enable "Google Sheets API".
#   2. IAM & Admin → Service Accounts → Create → Keys → Add JSON key.
#   3. Create a spreadsheet; share it with the service account email as Editor.
#   4. Set the three vars below in Vercel (and .env.local for local testing).
#
# Mirrored forms and their tabs (created automatically on first submission):
#   /api-access     → "API Access Requests"
#   /request-access → "Invite Requests"
# Every failed write logs:
#   [sheets] GOOGLE_SHEETS_APPEND_FAILED  {...reason, lost_row...}
# (success is silent except for the normal '[api-access] request stored' /
#  '[request-access] submission stored' lines).
# Alert on the FAILED token; the failure line carries the full row.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
