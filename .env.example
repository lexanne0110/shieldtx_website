# ShieldTX site env vars. Copy to .env.local for `vercel dev`.
# Never commit real secrets.

# Where the invite gate redirects on a valid code.
APP_URL=https://beta.shieldtx.xyz/

# Scanner backend used by the public preview proxy.
SCANNER_API_BASE=https://scanner-api-canary.shieldtx.avail.tools

# Scanner frontend opened after a report request.
SCANNER_APP_BASE=https://scanner-canary.shieldtx.avail.tools

# 32+ random bytes used to sign the short-lived invite cookie.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
INVITE_CODE_SECRET=

# Pepper for hashing client IPs before storage.
IP_HASH_PEPPER=

# DB connection string. Left blank in Phase 1 — lib/db.js falls back to an
# in-memory stub that logs submissions. Plug in Supabase/Neon/Vercel Postgres
# here when ready.
DATABASE_URL=

# Optional: comma-separated seed codes for local dev. When set and DATABASE_URL
# is blank, the in-memory stub treats each as an active code with unlimited uses.
DEV_SEED_INVITE_CODES=SHIELD-DEV
